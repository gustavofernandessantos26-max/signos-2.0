<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Descubra seu Signo</title>
  <style>
    html, body {
      margin: 0;
      padding: 0;
      min-height: 100%;
      background-color: #1a0a40;
      color: #ffffff;
      font-family: Arial, Helvetica, sans-serif;
    }

    body {
      background-color: #1a0a40;
      background-image:
        radial-gradient(circle at 20% 15%, #4b1d8a 0%, transparent 40%),
        radial-gradient(circle at 80% 85%, #2a1060 0%, transparent 45%),
        linear-gradient(#1a0a40, #0d0524);
    }

    .wrap {
      max-width: 820px;
      margin: 20px auto;
      padding: 18px;
    }

    .caixa {
      background-color: #2b1466;
      border: 4px solid #ffd76a;
      border-radius: 16px;
      padding: 22px 16px 28px;
      text-align: center;
      box-shadow: 0 0 25px #ffd76a;
    }

    h1 {
      color: #ffd76a;
      font-size: 32px;
      margin: 8px 0 10px;
    }

    h2 {
      color: #ffffff;
      margin: 0 0 12px;
    }

    p {
      color: #f3e9ff;
      font-size: 18px;
    }

    .bola {
      font-size: 64px;
      margin: 6px 0;
    }

    .tela { display: none; }
    .tela.ativa { display: block; }

    button {
      cursor: pointer;
      border: 2px solid #ffffff;
      border-radius: 10px;
      padding: 10px 16px;
      margin: 6px;
      font-size: 16px;
      font-weight: bold;
      color: #ffffff;
      background-color: #7b3cff;
    }

    button:hover { background-color: #9b63ff; }

    .dourado {
      background-color: #e0a020;
      color: #3a2000;
      font-size: 20px;
      padding: 12px 28px;
    }

    .azul {
      background-color: #1aa6bf;
      color: #062328;
    }

    .meses, .dias {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
    }

    .meses button { width: 140px; }
    .dias button { width: 48px; padding: 8px 0; }

    .simbolo {
      font-size: 72px;
      color: #ffd76a;
    }

    .nome-signo {
      color: #ffd76a;
      font-size: 28px;
      font-weight: bold;
    }

    .frase {
      background-color: #3b1d7a;
      border: 2px dashed #6ef0ff;
      border-radius: 12px;
      padding: 14px;
      color: #fff6d8;
      font-size: 18px;
    }

    .barra {
      width: 260px;
      height: 16px;
      margin: 16px auto 0;
      border: 3px solid #ffd76a;
      border-radius: 20px;
      background-color: #12082a;
      overflow: hidden;
    }

    .barra span {
      display: block;
      height: 100%;
      width: 0;
      background-color: #ff7ab6;
      animation: carregar 2s forwards;
    }

    @keyframes carregar {
      to { width: 100%; }
    }
  </style>
</head>
<body>
  <div class="wrap">
    <div class="caixa">

      <div id="inicio" class="tela ativa">
        <div class="bola">🔮</div>
        <h1>Descubra seu Signo</h1>
        <p>Escolha o mês e o dia do seu aniversário para revelar o signo.</p>
        <button class="dourado" onclick="mostrar('mes')">Jogar</button>
      </div>

      <div id="mes" class="tela">
        <h2>Qual o mês do seu aniversário?</h2>
        <div class="meses" id="gradeMes"></div>
      </div>

      <div id="dia" class="tela">
        <h2 id="textoDia">Qual o dia?</h2>
        <div class="dias" id="gradeDia"></div>
        <p><button class="azul" onclick="mostrar('mes')">Voltar</button></p>
      </div>

      <div id="espera" class="tela">
        <div class="bola">✨</div>
        <h2>Consultando as estrelas...</h2>
        <p>Os planetas estão se alinhando!</p>
        <div class="barra"><span></span></div>
      </div>

      <div id="resultado" class="tela">
        <div class="simbolo" id="simbolo">♈</div>
        <div class="nome-signo" id="nomeSigno">ÁRIES</div>
        <p class="frase" id="frase"></p>
        <p><button class="dourado" onclick="recomecar()">Jogar de novo</button></p>
      </div>

    </div>
  </div>

  <script>
    var meses = [
      "Janeiro","Fevereiro","Março","Abril","Maio","Junho",
      "Julho","Agosto","Setembro","Outubro","Novembro","Dezembro"
    ];

    var signos = {
      aries: ["Áries","♈","Você é corajoso, cheio de energia e adora começar aventuras novas!"],
      touro: ["Touro","♉","Você é calmo, determinado e gosta de coisas gostosas e confortáveis!"],
      gemeos: ["Gêmeos","♊","Você é curioso, conversador e adora aprender coisas novas!"],
      cancer: ["Câncer","♋","Você é carinhoso, protetor e sente as coisas com o coração!"],
      leao: ["Leão","♌","Você brilha como o Sol! Criativo, generoso e cheio de alegria."],
      virgem: ["Virgem","♍","Você é organizado, atento aos detalhes e adora ajudar os amigos!"],
      libra: ["Libra","♎","Você ama harmonia, beleza e justiça. Sempre busca o equilíbrio!"],
      escorpiao: ["Escorpião","♏","Você é leal e determinado. Quando gosta de alguém, defende de verdade!"],
      sagitario: ["Sagitário","♐","Você é aventureiro, otimista e adora explorar o mundo!"],
      capricornio: ["Capricórnio","♑","Você é responsável, persistente e sobe qualquer montanha!"],
      aquario: ["Aquário","♒","Você é original, amigável e traz ideias novas para o grupo!"],
      peixes: ["Peixes","♓","Você é sonhador, gentil e imaginativo. Cheio de bondade!"]
    };

    var mesEscolhido = 0;
    var diaEscolhido = 0;

    function mostrar(id) {
      var telas = document.getElementsByClassName("tela");
      for (var i = 0; i < telas.length; i++) {
        telas[i].className = "tela";
      }
      document.getElementById(id).className = "tela ativa";
    }

    function diasDoMes(mes) {
      var qtd = [31,29,31,30,31,30,31,31,30,31,30,31];
      return qtd[mes - 1];
    }

    function descobrirSigno(dia, mes) {
      if ((mes == 3 && dia >= 21) || (mes == 4 && dia <= 19)) return signos.aries;
      if ((mes == 4 && dia >= 20) || (mes == 5 && dia <= 20)) return signos.touro;
      if ((mes == 5 && dia >= 21) || (mes == 6 && dia <= 20)) return signos.gemeos;
      if ((mes == 6 && dia >= 21) || (mes == 7 && dia <= 22)) return signos.cancer;
      if ((mes == 7 && dia >= 23) || (mes == 8 && dia <= 22)) return signos.leao;
      if ((mes == 8 && dia >= 23) || (mes == 9 && dia <= 22)) return signos.virgem;
      if ((mes == 9 && dia >= 23) || (mes == 10 && dia <= 22)) return signos.libra;
      if ((mes == 10 && dia >= 23) || (mes == 11 && dia <= 21)) return signos.escorpiao;
      if ((mes == 11 && dia >= 22) || (mes == 12 && dia <= 21)) return signos.sagitario;
      if ((mes == 12 && dia >= 22) || (mes == 1 && dia <= 19)) return signos.capricornio;
      if ((mes == 1 && dia >= 20) || (mes == 2 && dia <= 18)) return signos.aquario;
      return signos.peixes;
    }

    function montarMeses() {
      var grade = document.getElementById("gradeMes");
      grade.innerHTML = "";
      for (var i = 0; i < meses.length; i++) {
        var b = document.createElement("button");
        b.innerHTML = meses[i];
        b.setAttribute("data-mes", i + 1);
        b.onclick = function () {
          escolherMes(parseInt(this.getAttribute("data-mes"), 10), this.innerHTML);
        };
        grade.appendChild(b);
      }
    }

    function escolherMes(n, nome) {
      mesEscolhido = n;
      document.getElementById("textoDia").innerHTML = "Mês: " + nome + ". Qual o dia?";
      var grade = document.getElementById("gradeDia");
      grade.innerHTML = "";
      var max = diasDoMes(n);
      for (var d = 1; d <= max; d++) {
        var b = document.createElement("button");
        b.innerHTML = d;
        b.setAttribute("data-dia", d);
        b.onclick = function () {
          escolherDia(parseInt(this.getAttribute("data-dia"), 10));
        };
        grade.appendChild(b);
      }
      mostrar("dia");
    }

    function escolherDia(d) {
      diaEscolhido = d;
      mostrar("espera");
      setTimeout(mostrarResultado, 2000);
    }

    function mostrarResultado() {
      var s = descobrirSigno(diaEscolhido, mesEscolhido);
      document.getElementById("simbolo").innerHTML = s[1];
      document.getElementById("nomeSigno").innerHTML = s[0];
      document.getElementById("frase").innerHTML = s[2];
      mostrar("resultado");
    }

    function recomecar() {
      mesEscolhido = 0;
      diaEscolhido = 0;
      mostrar("inicio");
    }

    montarMeses();
  </script>
</body>
</html>
